# Modelo do .env do backend. Copie para `.env` e ajuste o que precisar:
#
#     copy .env.example .env
#
# Nenhuma destas chaves é obrigatória — todas têm padrão em app/core/config.py, e a
# aplicação sobe sem arquivo nenhum. O .env existe para o que muda por instalação.
# Ele nunca é versionado: guarda a senha da administração e a chave que decifra as
# senhas das faciais.

# Acesso à administração. A tela da portaria continua aberta, sem senha, porque a
# guarita precisa subir sozinha — mas as rotas administrativas recusam quem não fez
# login. Trocar isto é o primeiro passo em qualquer instalação real: o padrão é
# `prever` / `prever`, e a aplicação avisa no log enquanto ele estiver em uso.
ADMIN_USERNAME=prever
ADMIN_PASSWORD=prever
ADMIN_SESSION_MINUTES=30

# Chave Fernet que protege as senhas dos equipamentos. Deixe em branco: na primeira
# execução a aplicação gera uma e guarda em `device-credentials.key`, ao lado do
# banco.
#
# Ela pertence ao banco que cifrou. Restaurar um backup de um sem o outro deixa as
# senhas ilegíveis e os equipamentos param de autenticar — os dois arquivos viajam
# juntos, e nenhum dos dois vai para o repositório.
DEVICE_CREDENTIALS_KEY=

# Só o próprio computador enxerga a aplicação. A porta é configurável porque 8000 é
# disputada; numa máquina onde já exista algo nela, a aplicação não subiria.
API_HOST=127.0.0.1
API_PORT=8000

# Onde o banco fica. Vazio usa `pmoni.db` no diretório de dados — o próprio
# `backend` em desenvolvimento, e `%LOCALAPPDATA%\pMoni` no programa instalado.
# DATABASE_URL=sqlite:///pmoni.db

# Pausa entre as consultas ao journal de cada facial, em segundos.
# DEVICE_POLL_INTERVAL_SECONDS=1.0

# LOG_LEVEL=INFO
